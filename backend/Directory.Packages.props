<Project>

  <!--
    Central Package Management: every NuGet version lives here, projects reference
    packages without a Version attribute. See https://learn.microsoft.com/nuget/consume-packages/central-package-management
    Find updates with "dotnet list kroet.ShareIt.slnx package" plus the outdated flag in backend/.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Keep the Aspire packages and the Aspire.AppHost.Sdk version in
       kroet.ShareIt.AppHost/kroet.ShareIt.AppHost.csproj in lockstep. -->
  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.4" />
  </ItemGroup>

  <ItemGroup Label="API">
    <PackageVersion Include="Asp.Versioning.Http" Version="10.2.3" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.9" />
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Authorization" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="MSTest" Version="4.5.2" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
  </ItemGroup>

</Project>
