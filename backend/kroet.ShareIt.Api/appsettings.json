{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "RequireHttpsMetadata": true,
    "Dpop": {
      "Required": true,
      "ProofMaxAgeSeconds": 300
    }
  },
  "DownloadSettings": {
    "AccessSessionLifetimeMinutes": 15,
    "ExhaustedPackageRetentionMinutes": 30
  },
  "RateLimitSettings": {
    "PackageReadPermitLimit": 20,
    "PackageReadWindowMinutes": 15,
    "ShortCodeLookupPermitLimit": 20,
    "ShortCodeLookupWindowMinutes": 15,
    "DownloadPermitLimit": 120,
    "DownloadWindowMinutes": 1,
    "UploadPermitLimit": 120,
    "UploadWindowMinutes": 1
  },
  "CleanupSettings": {
    "CleanupIntervalMinutes": 5
  },
  "UploadSettings": {
    "MaxRequestBodySizeMb": 512,
    "MaxItemsPerPackage": 100,
    "Anonymous": {
      "FileLimitMb": 25,
      "MaxLifetimeHours": 6,
      "MaxAccessCount": 1
    },
    "Authenticated": {
      "FileLimitMb": 100,
      "MaxLifetimeHours": 720,
      "MaxAccessCount": 10
    }
  }
}
