{
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Auth": {
    "Dpop": {
      "Required": true,
      "ProofMaxAgeSeconds": 300
    }
  },
  "DownloadSettings": {
    "DefaultTokenExpirationMinutes": 15,
    "UsedTokenRetentionHours": 24,
    "InlineTextLimitKb": 64
  },
  "CleanupSettings": {
    "CleanupIntervalMinutes": 5
  },
  "UploadSettings": {
    "MaxRequestBodySizeMb": 512,
    "Anonymous": {
      "FileLimitMb": 25,
      "MaxLifetimeHours": 6,
      "MaxDownloadCount": 1
    },
    "Authenticated": {
      "FileLimitMb": 100,
      "MaxLifetimeHours": 720,
      "MaxDownloadCount": 10
    }
  }
}
