{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DownloadSettings": {
    "DefaultTokenExpirationMinutes": 15,
    "UsedTokenRetentionHours": 24,
    "InlineTextLimitKb": 64
  },
  "CleanupSettings": {
    "CleanupIntervalMinutes": 5
  },
  "UploadSettings": {
    "AnonymousFileLimitMb": 25,
    "AuthenticatedFileLimitMb": 100,
    "MaxRequestBodySizeMb": 512
  }
}
