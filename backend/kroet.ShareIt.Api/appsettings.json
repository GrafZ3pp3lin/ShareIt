{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDB": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "ShareItDb"
  },
  "BlobStorage": {
    "MaxEmbeddedSize": 262144
  },
  "AzureBlobStorage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "ContainerName": "content-files"
  },
  "Download": {
    "DefaultTokenExpirationMinutes": 15,
    "DefaultMaxDownloads": null,
    "ValidateClientIp": false,
    "CleanupIntervalMinutes": 5,
    "UsedTokenRetentionHours": 24
  }
}
