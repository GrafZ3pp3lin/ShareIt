{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3} {SourceContext} | {Message:l}{NewLine}{Exception}"
        }
      },
      {
        "Name": "OpenTelemetry",
        "Args": {
          "endpoint": "http://otel-collector:4317",
          "protocol": "Grpc",
          "resourceAttributes": {
            "service.name": "shareit-api",
            "deployment.environment.name": "Production"
          }
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "ApplicationName": "kroet.ShareIt.Api"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Auth": {
    "Authority": "",
    "Audience": ""
  },
  "BlobStorage": {
    "S3": {
      "AccessKeyId": "",
      "SecretAccessKey": "",
      "ServiceUrl": "",
      "BucketName": "content-files"
    }
  },
  "ContentStorage": {
    "PostgreSqlDb": {
      "ConnectionString": "",
      "AutoInitializeSchema": true
    }
  },
  "DownloadSettings": {
    "AccessSessionLifetimeMinutes": 15,
    "ExhaustedPackageRetentionMinutes": 30,
    "InlinePayloadLimitBytes": 16384,
    "InlinePayloadBudgetBytes": 65536
  },
  "RateLimitSettings": {
    "PackageReadPermitLimit": 20,
    "PackageReadWindowMinutes": 15,
    "DownloadPermitLimit": 120,
    "DownloadWindowMinutes": 1
  },
  "CleanupSettings": {
    "CleanupIntervalMinutes": 5
  },
  "UploadSettings": {
    "MaxRequestBodySizeMb": 512,
    "Anonymous": {
      "FileLimitMb": 25,
      "MaxLifetimeHours": 6,
      "MaxAccessCount": 1
    },
    "Authenticated": {
      "FileLimitMb": 100,
      "MaxLifetimeHours": 720,
      "MaxAccessCount": 10
    }
  }
}
