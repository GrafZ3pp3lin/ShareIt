{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["dist/**", "src/client/**"],
  "plugins": ["import"],
  "categories": {
    "correctness": "warn"
  },
  "env": {
    "builtin": true
  },
  "rules": {
    "import/extensions": ["error", "always", { "ignorePackages": true }]
  }
}
